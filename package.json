{
  "name": "c2egf-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && node scripts/compatCss.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "account:diagnose": "node scripts/diagnoseAccount.mjs",
    "account:reset-link": "node scripts/generatePasswordResetLink.mjs",
    "account:test-login": "node --env-file=.env scripts/testClientLogin.mjs",
    "account:update-password": "node scripts/updateAccountPassword.mjs",
    "account:create-temp-access": "node scripts/createTemporaryStoreAccess.mjs",
    "account:restore": "node scripts/restoreDeletedAccount.mjs",
    "seed:stores": "node scripts/seedStores.mjs",
    "accounts:delete:dry-run": "node scripts/deleteExistingAccounts.mjs",
    "accounts:delete": "node scripts/deleteExistingAccounts.mjs --execute",
    "reset:dry-run": "node scripts/resetDataToZero.mjs",
    "reset:execute": "node scripts/resetDataToZero.mjs --execute",
    "reset:restore:dry-run": "node scripts/restoreFromBackup.mjs",
    "reset:restore": "node scripts/restoreFromBackup.mjs --execute",
    "test:unit": "vitest run --config vitest.config.js tests/unit",
    "test:components": "vitest run --config vitest.config.js tests/components",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-akayis-test \"npx vitest run --config vitest.firestore.config.js\"",
    "test:firestore:smoke": "firebase emulators:exec --only firestore --project demo-akayis-test \"npx vitest run --config vitest.firestore.config.js tests/firestore/smoke.test.js\"",
    "test:integration": "firebase emulators:exec --only auth,firestore --project demo-akayis-test \"npx vitest run --config vitest.integration.config.js\"",
    "test:commands": "vitest run --config vitest.config.js tests/unit/tc-034-dealer-request-commands.test.js",
    "test:functions": "firebase emulators:exec --only firestore --project demo-akayis-test \"npx vitest run --config vitest.functions.config.js\"",
    "test:functions:e2e": "firebase emulators:exec --only auth,firestore,functions --project demo-akayis-test \"npx vitest run --config vitest.functions-e2e.config.js\"",
    "v2:user:create": "node scripts/createTechnicalUser.mjs",
    "v2:user:verify": "node scripts/verifyTechnicalUser.mjs",
    "v2:user:delete": "node scripts/deleteTechnicalUser.mjs",
    "capture": "node scripts/qa-visuelle.mjs"
  },
  "dependencies": {
    "firebase": "^12.2.1",
    "lucide-react": "^1.34.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@firebase/rules-unit-testing": "5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "browserslist": "^4.26.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "firebase-admin": "^13.10.0",
    "globals": "^16.3.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.30.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.2",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.9"
  }
}
