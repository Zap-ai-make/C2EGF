# Configuration Firebase
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs
VITE_CLIENT_ID=c2egf_burkina
VITE_FIRESTORE_USE_CLIENT_NAMESPACE=true
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Environment
VITE_APP_ENV=development

# Logging
VITE_LOG_LEVEL=info

# Firestore Settings
VITE_FIRESTORE_OFFLINE_PERSISTENCE=true
VITE_FIRESTORE_CACHE_SIZE_BYTES=40000000
