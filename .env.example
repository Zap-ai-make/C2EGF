# Configuration Firebase
# Copiez ce fichier vers .env et remplissez avec vos vraies valeurs
VITE_CLIENT_ID=c2egf_burkina
VITE_FIRESTORE_USE_CLIENT_NAMESPACE=true
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-c2egf-local
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_RUNTIME_MODE=development
VITE_USE_FIREBASE_EMULATORS=true

# Environment
VITE_APP_ENV=development

# Logging
VITE_LOG_LEVEL=info

# Firestore Settings
VITE_FIRESTORE_OFFLINE_PERSISTENCE=true
VITE_FIRESTORE_CACHE_SIZE_BYTES=40000000
# Hors production, la persistance est coupée. Mettre `true` pour essayer le
# hors-ligne sur les émulateurs, dans un navigateur neuf seulement
# (src/config/firebase.js).
# VITE_FIRESTORE_PERSISTANCE_EMULATEURS=true

# Assistant IA — toutes facultatives (docs/ia/LOT-APPCHECK.md)
# Clé de site reCAPTCHA Enterprise d'App Check. Absente, l'assistant se tait ;
# la caisse fonctionne comme avant. Jamais lue avec les émulateurs.
# VITE_FIREBASE_APPCHECK_KEY=your_recaptcha_enterprise_site_key
# Jeton de débogage App Check, lu en développement seulement. À poser plutôt
# dans .env.development.local ; « true » en fait imprimer un dans la console.
# VITE_APPCHECK_DEBUG_TOKEN=true
# Absente : Agent Platform, facturé sur le compte Google Cloud du projet.
# « googleAI » revient au backend Developer et à sa cagnotte prépayée.
# VITE_AI_BACKEND=googleAI
# Absente : emplacement « global ».
# VITE_AI_LOCATION=global
# Absente : le modèle par défaut de src/lib/ia/assistant.js.
# VITE_AI_MODEL=gemini-3.5-flash
